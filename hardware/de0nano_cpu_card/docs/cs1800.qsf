set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"

set_global_assignment -name USE_CONFIGURATION_DEVICE OFF
set_global_assignment -name CRC_ERROR_OPEN_DRAIN OFF
set_global_assignment -name RESERVE_DATA0_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_DATA1_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_FLASH_NCE_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_DCLK_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name OUTPUT_IO_TIMING_NEAR_END_VMEAS "HALF VCCIO" -rise
set_global_assignment -name OUTPUT_IO_TIMING_NEAR_END_VMEAS "HALF VCCIO" -fall
set_global_assignment -name OUTPUT_IO_TIMING_FAR_END_VMEAS "HALF SIGNAL SWING" -rise
set_global_assignment -name OUTPUT_IO_TIMING_FAR_END_VMEAS "HALF SIGNAL SWING" -fall



#============================================================
# Clock on the DE0-nano board:
#============================================================
set_location_assignment PIN_R8 -to clk_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk_50


#============================================================
# EPCS on the DE0-nano board:
#============================================================
set_location_assignment PIN_H2 -to EPCS_DATA0
set_location_assignment PIN_H1 -to EPCS_DCLK
set_location_assignment PIN_D2 -to EPCS_SCE
set_location_assignment PIN_C1 -to EPCS_SDO
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to EPCS_DATA0
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to EPCS_DCLK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to EPCS_SCE
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to EPCS_SDO

#============================================================
# PIO_LED : on the DE0-nano board inself
#============================================================
set_location_assignment PIN_L3 -to led_Q
set_location_assignment PIN_B1 -to led_fetch
set_location_assignment PIN_F3 -to led_exec
set_location_assignment PIN_D1 -to led_dma_ack
set_location_assignment PIN_A11 -to led_int_ack
set_location_assignment PIN_B13 -to pio_led[2]
set_location_assignment PIN_A13 -to pio_led[1]
set_location_assignment PIN_A15 -to pio_led[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_Q
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_fetch
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_exec
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_dma_ack
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_int_ack
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to pio_led[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to pio_led[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to pio_led[0]
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to pio_led[0]
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to pio_led[1]
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to pio_led[2]
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to led_int_ack
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to led_dma_ack
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to led_exec
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to led_fetch
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to led_Q


#============================================================
# KEY : on the DE0-nano board inself
#============================================================
set_location_assignment PIN_J15 -to KEY[0]
set_location_assignment PIN_E1 -to KEY[1]

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY[1]


#============================================================
# DIP SWITCH : on the DE0-nano board inself
#============================================================
set_location_assignment PIN_M1 -to SW[0]
set_location_assignment PIN_T8 -to SW[1]
set_location_assignment PIN_B9 -to SW[2]
set_location_assignment PIN_M15 -to SW[3]

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[3]



#============================================================
# Connection to the CS1800 backplane
# gpio0 : JP1 : the 40 pin header which will connect the level shifters (via ribbon cable)
#============================================================

# LC 50Hz: in   GPIO_00   JP1 pin 2
set_location_assignment PIN_D3 -to LC
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LC

# nINT: in    GPIO_01   JP1 pin 4
set_location_assignment PIN_C3 -to nINT
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to nINT

# nMWR: out    GPIO_02   JP1 pin 5
set_location_assignment PIN_A2 -to nMWR
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to nMWR

# TPA: out    GPIO_03   JP1 pin 6
set_location_assignment PIN_A3 -to TPA
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to TPA

# nMRD: out    GPIO_04   JP1 pin 7
set_location_assignment PIN_B3 -to nMRD
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to nMRD

# TPB: out    GPIO_05   JP1 pin 8
set_location_assignment PIN_B4 -to TPB
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to TPB



# DATA_DIR : out : setting the direction of the 8T245 levelshifter of the databus
# GPIO_06   JP1 pin 9
# PCB: pull this DOWN. Its safe default is B->A (the backplane drives, we
# listen); if it floats or defaults high while the FPGA is unconfigured,
# this module drives the rack's data bus against the real memory.
set_location_assignment PIN_A4 -to DATA_DIR 
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to DATA_DIR

# DATA_nOE : out : output-enable of the databus 8T245 (active low).
# GPIO_07   JP1 pin 10
# Two jobs: keep the transceiver off until the core is running, and give
# the read->write turnaround a deliberate dead time -- DIR alone cannot do
# that, it swaps direction without ever turning the driver off.
# PCB: pull this UP, so "disabled" is the power-on default.
set_location_assignment PIN_B5 -to DATA_nOE
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to DATA_nOE

# BUF_nOE : out : output-enable of the two outgoing 8T245s (active low),
# GPIO_08   JP1 pin 13
# so the backplane sees nothing from this card until the FPGA is
# configured and the CPU is out of reset. Without it, TPA/TPB/Q sit at
# whatever the FPGA's weak pull-ups give during configuration.
# PCB: pull this UP too.
set_location_assignment PIN_A5 -to BUF_nOE
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to BUF_nOE



# DATA[7]: inout  GPIO_09   JP1 pin 14
set_location_assignment PIN_D5 -to DATA[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to DATA[7]

# DATA[6]: inout  GPIO_010   JP1 pin 15
set_location_assignment PIN_B6 -to DATA[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to DATA[6]

# DATA[5]: inout  GPIO_011   JP1 pin 16
set_location_assignment PIN_A6 -to DATA[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to DATA[5]

# DATA[4]: inout  GPIO_012   JP1 pin 17
set_location_assignment PIN_B7 -to DATA[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to DATA[4]

