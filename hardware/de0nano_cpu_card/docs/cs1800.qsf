# DATA[0]: inout  GPIO_016   JP1 pin 21
set_location_assignment PIN_C8 -to DATA[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to DATA[0]




# ADDR[7]: out  GPIO_017   JP1 pin 22
set_location_assignment PIN_E6 -to ADDR[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ADDR[7]

# ADDR[6]: out  GPIO_018   JP1 pin 23
set_location_assignment PIN_E7 -to ADDR[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ADDR[6]

# ADDR[5]: out  GPIO_019   JP1 pin 24
