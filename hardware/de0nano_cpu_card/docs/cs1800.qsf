set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ADDR[3]

# ADDR[2]: out    GPIO_022   JP1 pin 27
set_location_assignment PIN_F9 -to ADDR[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ADDR[2]

# ADDR[1]: out  GPIO_023   JP1 pin 28
set_location_assignment PIN_E9 -to ADDR[1]
