# nEF[2]: in    GPIO_027   JP1 pin 34
set_location_assignment PIN_E10 -to nEF[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to nEF[2]

# N[2]: out    GPIO_028   JP1 pin 35
set_location_assignment PIN_C11 -to N[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to N[2]

# N[1]: out    GPIO_029   JP1 pin 36
set_location_assignment PIN_B11 -to N[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to N[1]

# N[0]: out    GPIO_030   JP1 pin 37
